{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "record_version": {
      "type": "number",
      "const": 1
    },
    "record_kind": {
      "type": "string",
      "const": "target_index"
    },
    "target": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "issue_number": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "repo",
        "issue_number"
      ],
      "additionalProperties": false
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "run_ids": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_ids": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcome_ids": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "record_version",
    "record_kind",
    "target",
    "updated_at",
    "run_ids",
    "decision_ids",
    "outcome_ids"
  ],
  "additionalProperties": false
}
