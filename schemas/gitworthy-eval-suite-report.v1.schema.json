{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "default": "1.0-draft.1",
      "type": "string",
      "const": "1.0-draft.1"
    },
    "suite": {
      "type": "string",
      "enum": [
        "frozen",
        "live",
        "private"
      ]
    },
    "release_blocking": {
      "type": "boolean"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "gitworthy_version": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "drifted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "blocked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "provider_failure": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "auth_limitation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "product_regression": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "total",
        "passed",
        "failed",
        "drifted",
        "blocked",
        "provider_failure",
        "auth_limitation",
        "product_regression"
      ],
      "additionalProperties": false
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "drifted",
              "blocked",
              "provider_failure",
              "auth_limitation",
              "product_regression"
            ]
          },
          "detail": {
            "type": "string"
          },
          "failure_mode": {
            "type": "string"
          },
          "function": {
            "type": "string",
            "enum": [
              "branch_scan",
              "issue_vs_main",
              "release_gap",
              "dupe_cluster",
              "contrib_policy",
              "linked_work",
              "worth_check"
            ]
          },
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "expected_verdict": {
            "type": "string",
            "enum": [
              "ACT",
              "VERIFY",
              "SKIP"
            ]
          },
          "observed_verdict": {
            "type": "string",
            "enum": [
              "ACT",
              "VERIFY",
              "SKIP"
            ]
          },
          "expected_disposition": {
            "type": "string",
            "enum": [
              "greenfield",
              "land_only",
              "claim_first",
              "blocked",
              "crowded",
              "review"
            ]
          },
          "observed_disposition": {
            "type": "string",
            "enum": [
              "greenfield",
              "land_only",
              "claim_first",
              "blocked",
              "crowded",
              "review"
            ]
          },
          "hard_skip": {
            "type": "boolean"
          },
          "verify_reason": {
            "type": "string",
            "minLength": 1
          },
          "duration_ms": {
            "type": "number",
            "minimum": 0
          },
          "github_requests": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "schema_valid": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "suite",
    "release_blocking",
    "generated_at",
    "gitworthy_version",
    "summary",
    "rows",
    "notes"
  ],
  "additionalProperties": false
}
