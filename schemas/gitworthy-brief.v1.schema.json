{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "brief_schema_version": {
      "type": "string",
      "const": "brief.v1"
    },
    "rendering_version": {
      "type": "string",
      "const": "brief-human.v1"
    },
    "command": {
      "type": "string",
      "const": "brief"
    },
    "target": {
      "type": "object",
      "properties": {
        "input_repo": {
          "type": "string",
          "minLength": 1
        },
        "canonical_repo": {
          "type": "string",
          "minLength": 1
        },
        "issue_number": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "issue_state": {
          "type": "string"
        },
        "issue_url": {
          "type": "string"
        },
        "head_sha": {
          "type": "string"
        }
      },
      "required": [
        "input_repo",
        "canonical_repo",
        "issue_number"
      ],
      "additionalProperties": false
    },
    "verdict": {
      "type": "string",
      "enum": [
        "ACT",
        "VERIFY",
        "SKIP"
      ]
    },
    "disposition": {
      "type": "string",
      "enum": [
        "greenfield",
        "land_only",
        "claim_first",
        "blocked",
        "crowded",
        "review"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "source_records": {
      "type": "object",
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "run_found": {
          "type": "boolean"
        },
        "outcome_ids": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "decision_id",
        "run_id",
        "run_found",
        "outcome_ids"
      ],
      "additionalProperties": false
    },
    "decision_created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "run_generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "ranked_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "strength": {
            "type": "string",
            "enum": [
              "definitive",
              "corroborated",
              "heuristic"
            ]
          },
          "effect": {
            "type": "string",
            "enum": [
              "block",
              "verify",
              "inform"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          },
          "data": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "type",
          "strength",
          "effect",
          "source",
          "message",
          "data"
        ],
        "additionalProperties": false
      }
    },
    "contribution_policy": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          },
          "data": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "type",
          "message",
          "data"
        ],
        "additionalProperties": false
      }
    },
    "claim_requirements": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          },
          "data": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "type",
          "message",
          "data"
        ],
        "additionalProperties": false
      }
    },
    "linked_work": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          },
          "data": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "type",
          "message",
          "data"
        ],
        "additionalProperties": false
      }
    },
    "prior_attempts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          },
          "data": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "type",
          "message",
          "data"
        ],
        "additionalProperties": false
      }
    },
    "named_paths_symbols": {
      "type": "object",
      "properties": {
        "paths": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "symbols": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "paths",
        "symbols"
      ],
      "additionalProperties": false
    },
    "checks_not_completed": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_urls": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "stop_conditions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "staleness_warning": {
      "type": "object",
      "properties": {
        "stale": {
          "type": "boolean"
        },
        "threshold_hours": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "age_hours": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "basis": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "warning": {
          "type": "string"
        },
        "recommend": {
          "type": "string",
          "const": "recheck"
        }
      },
      "required": [
        "stale",
        "threshold_hours",
        "age_hours",
        "basis"
      ],
      "additionalProperties": false
    },
    "config_provenance": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "object",
          "properties": {
            "value": {},
            "provenance": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        },
        "manifest": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "provenance": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "summary": {
              "type": "object",
              "properties": {
                "repos": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "orgs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "package_mappings": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "repos",
                "orgs",
                "package_mappings"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "summary"
          ],
          "additionalProperties": false
        },
        "loaded": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "layer": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "present": {
                "type": "boolean"
              }
            },
            "required": [
              "layer",
              "path",
              "present"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "loaded"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "brief_schema_version",
    "rendering_version",
    "command",
    "target",
    "verdict",
    "disposition",
    "summary",
    "source_records",
    "decision_created_at",
    "ranked_findings",
    "contribution_policy",
    "claim_requirements",
    "linked_work",
    "prior_attempts",
    "named_paths_symbols",
    "checks_not_completed",
    "evidence_urls",
    "next_actions",
    "stop_conditions",
    "staleness_warning"
  ],
  "additionalProperties": false
}
