{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "default": "1.0-draft.1",
      "type": "string",
      "const": "1.0-draft.1"
    },
    "record_version": {
      "type": "number",
      "const": 1
    },
    "record_kind": {
      "type": "string",
      "const": "capture"
    },
    "capture_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "gitworthy_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string"
    },
    "decision_id": {
      "type": "string"
    },
    "decision_ids": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "command": {
      "type": "string",
      "enum": [
        "check",
        "hunt"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "repo_issue",
            "repo",
            "org"
          ]
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "canonical": {
          "type": "string"
        },
        "issue_number": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "html_url": {
          "type": "string",
          "format": "uri"
        },
        "is_private": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "input",
        "is_private"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "surface": {
          "type": "string",
          "enum": [
            "cli",
            "mcp",
            "test",
            "unknown"
          ]
        },
        "requested_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "surface",
        "requested_at",
        "attribution"
      ],
      "additionalProperties": false
    },
    "capture_mode": {
      "type": "string",
      "enum": [
        "public",
        "local_only"
      ]
    },
    "promotable": {
      "type": "boolean"
    },
    "exchanges": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "captured_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "provider": {
            "type": "string",
            "enum": [
              "github",
              "github_raw",
              "npm",
              "unknown"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "canonical_url": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "request_headers": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "response_headers": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "request_body_digest_sha256": {
            "default": null,
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "body_digest_sha256": {
            "default": null,
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "body_omitted_reason": {
            "type": "string"
          },
          "response_fields": {}
        },
        "required": [
          "sequence",
          "captured_at",
          "provider",
          "method",
          "canonical_url",
          "status",
          "request_headers",
          "response_headers",
          "request_body_digest_sha256",
          "body_digest_sha256"
        ],
        "additionalProperties": false
      }
    },
    "errors": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "record_version",
    "record_kind",
    "capture_id",
    "created_at",
    "updated_at",
    "gitworthy_version",
    "decision_ids",
    "command",
    "target",
    "source",
    "capture_mode",
    "promotable",
    "exchanges",
    "errors"
  ],
  "additionalProperties": false
}
