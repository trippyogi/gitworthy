{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "fixture_version": {
      "type": "number",
      "const": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "capture_id": {
          "type": "string",
          "minLength": 1
        },
        "capture_created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "gitworthy_version": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "enum": [
            "check",
            "hunt"
          ]
        },
        "run_id": {
          "type": "string"
        },
        "decision_id": {
          "type": "string"
        },
        "decision_ids": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "repo_issue",
                "repo",
                "org"
              ]
            },
            "input": {
              "type": "string",
              "minLength": 1
            },
            "canonical": {
              "type": "string"
            },
            "issue_number": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "html_url": {
              "type": "string",
              "format": "uri"
            },
            "is_private": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "input",
            "is_private"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "capture_id",
        "capture_created_at",
        "gitworthy_version",
        "command",
        "decision_ids",
        "target"
      ],
      "additionalProperties": false
    },
    "ground_truth": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "ACT",
            "VERIFY",
            "SKIP"
          ]
        },
        "disposition": {
          "type": "string",
          "enum": [
            "greenfield",
            "land_only",
            "claim_first",
            "blocked",
            "crowded",
            "review"
          ]
        },
        "adjudicator_rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence_urls": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "required": [
        "verdict",
        "disposition",
        "adjudicator_rationale",
        "evidence_urls"
      ],
      "additionalProperties": false
    },
    "replay": {
      "type": "object",
      "properties": {
        "exchanges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "provider": {
                "type": "string",
                "enum": [
                  "github",
                  "github_raw",
                  "npm",
                  "unknown"
                ]
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "canonical_url": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "response_headers": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "body_digest_sha256": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "body_omitted_reason": {
                "type": "string"
              },
              "response_fields": {}
            },
            "required": [
              "sequence",
              "provider",
              "method",
              "canonical_url",
              "status",
              "response_headers",
              "body_digest_sha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "exchanges"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "fixture_version",
    "source",
    "ground_truth",
    "replay"
  ],
  "additionalProperties": false
}
