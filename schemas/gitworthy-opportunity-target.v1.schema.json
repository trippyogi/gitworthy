{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "issue"
        },
        "repo": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\\/[A-Za-z0-9._](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
        },
        "issue_number": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "repo",
        "issue_number"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "pull_request"
        },
        "repo": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\\/[A-Za-z0-9._](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
        },
        "pr_number": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "linked_issue_number": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "repo",
        "pr_number"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "eval_anomaly"
        },
        "repo": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\\/[A-Za-z0-9._](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
        },
        "external_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "external_id",
        "source"
      ],
      "additionalProperties": false
    }
  ]
}
