{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0-draft.1"
    },
    "gitworthy_version": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "string",
      "const": "check"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "cached": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "checked": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "not_checked": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "skipped",
              "failed",
              "not_applicable"
            ]
          },
          "duration_ms": {
            "type": "number",
            "minimum": 0
          },
          "cached": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "strength": {
            "type": "string",
            "enum": [
              "definitive",
              "corroborated",
              "heuristic"
            ]
          },
          "effect": {
            "type": "string",
            "enum": [
              "block",
              "verify",
              "inform"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          },
          "data": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "type",
          "strength",
          "effect",
          "source",
          "message",
          "data"
        ],
        "additionalProperties": false
      }
    },
    "metrics": {
      "default": {},
      "type": "object",
      "properties": {
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "github_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "git_commands": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bytes_read": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cache_hits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": {}
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "properties": {
        "input_repo": {
          "type": "string",
          "minLength": 1
        },
        "canonical_repo": {
          "type": "string",
          "minLength": 1
        },
        "issue_number": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "issue_state": {
          "type": "string"
        },
        "issue_url": {
          "type": "string"
        },
        "head_sha": {
          "type": "string"
        }
      },
      "required": [
        "input_repo",
        "canonical_repo",
        "issue_number"
      ],
      "additionalProperties": false
    },
    "verdict": {
      "type": "string",
      "enum": [
        "ACT",
        "VERIFY",
        "SKIP"
      ]
    },
    "disposition": {
      "type": "string",
      "enum": [
        "greenfield",
        "land_only",
        "claim_first",
        "blocked",
        "crowded",
        "review"
      ]
    },
    "next_actions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "verdict_summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sub_results": {
      "type": "array",
      "items": {}
    },
    "timings_ms": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "perf": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "schema_version",
    "gitworthy_version",
    "command",
    "run_id",
    "generated_at",
    "cached",
    "summary",
    "checked",
    "not_checked",
    "checks",
    "findings",
    "metrics",
    "decision_id",
    "target",
    "verdict",
    "disposition",
    "next_actions"
  ],
  "additionalProperties": false
}
