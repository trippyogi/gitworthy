        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "counts_by_contention": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
