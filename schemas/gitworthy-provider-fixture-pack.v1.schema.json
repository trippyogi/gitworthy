{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "default": "1.0-draft.1",
      "type": "string",
      "const": "1.0-draft.1"
    },
    "fixture_version": {
      "type": "number",
      "const": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "attributed_from": {
      "type": "object",
      "properties": {
        "capture_id": {
          "type": "string",
          "minLength": 1
        },
        "capture_created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "gitworthy_version": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "http_exchanges": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "provider": {
            "type": "string",
            "enum": [
              "github",
              "github_raw",
              "npm",
              "unknown"
            ]
          },
          "match": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1
              },
              "canonical_url": {
                "type": "string",
                "minLength": 1
              },
              "request_body_digest_sha256": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "method",
              "canonical_url",
              "request_body_digest_sha256"
            ],
            "additionalProperties": false
          },
          "response": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "headers": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "body_encoding": {
                "default": "json",
                "type": "string",
                "enum": [
                  "json",
                  "text",
                  "base64",
                  "omitted"
                ]
              },
              "body": {},
              "body_omitted_reason": {
                "type": "string"
              },
              "error": {
                "type": "string",
                "enum": [
                  "timeout",
                  "network",
                  "abort"
                ]
              }
            },
            "required": [
              "headers",
              "body_encoding"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "sequence",
          "provider",
          "match",
          "response"
        ],
        "additionalProperties": false
      }
    },
    "git_probes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "enum": [
              "ls_remote_heads",
              "shallow_clone",
              "list_tree",
              "read_tree_file"
            ]
          },
          "match": {
            "type": "object",
            "properties": {
              "repo": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "repo"
            ],
            "additionalProperties": false
          },
          "response": {
            "type": "object",
            "properties": {
              "heads": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "name",
                    "sha"
                  ],
                  "additionalProperties": false
                }
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "content": {
                      "type": "string"
                    },
                    "symlink": {
                      "default": false,
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "path",
                    "content",
                    "symlink"
                  ],
                  "additionalProperties": false
                }
              },
              "truncated": {
                "type": "boolean"
              },
              "content": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "error": {
                "type": "string",
                "enum": [
                  "ls_remote_failed",
                  "clone_failed",
                  "ls_tree_failed",
                  "read_failed"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "sequence",
          "kind",
          "match",
          "response"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "fixture_version",
    "case_id",
    "http_exchanges",
    "git_probes"
  ],
  "additionalProperties": false
}
