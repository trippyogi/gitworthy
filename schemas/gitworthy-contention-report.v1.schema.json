{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contention_version": {
      "type": "number",
      "const": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "uncontested",
        "contested",
        "superseded",
        "resolved"
      ]
    },
    "claims": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pr": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "closed"
            ]
          },
          "draft": {
            "default": false,
            "type": "boolean"
          },
          "merged": {
            "default": false,
            "type": "boolean"
          },
          "author": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "closed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "timeline",
              "search",
              "comment",
              "title_overlap",
              "branch_name"
            ]
          },
          "closes_issue": {
            "default": false,
            "type": "boolean"
          },
          "diff_stat": {
            "type": "object",
            "properties": {
              "additions": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "deletions": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "changed_files": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "truncated": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "touched_paths": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "touched_symbols": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "pr",
          "repo",
          "state",
          "draft",
          "merged",
          "author",
          "title",
          "url",
          "created_at",
          "source",
          "closes_issue",
          "touched_paths",
          "touched_symbols"
        ],
        "additionalProperties": false
      }
    },
    "equivalence_classes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "enum": [
              "same_change",
              "overlapping",
              "distinct"
            ]
          },
          "prs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "representative": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "shared_paths": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "shared_symbols": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "low_confidence": {
            "default": false,
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "relation",
          "prs",
          "representative",
          "shared_paths",
          "shared_symbols",
          "low_confidence"
        ],
        "additionalProperties": false
      }
    },
    "gaps": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "test_coverage",
              "stated_ask",
              "adjacent_risk",
              "scope_excess",
              "uncovered_surface"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prs": {
            "default": [],
            "type": "array",
            "items": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "symbols": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "low_confidence": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "summary",
          "evidence",
          "prs",
          "symbols",
          "low_confidence"
        ],
        "additionalProperties": false
      }
    },
    "swarm_risk": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "posture": {
      "type": "string",
      "enum": [
        "race",
        "differentiate",
        "defer"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "bytes_read": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "artifacts_read": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "truncated": {
          "type": "boolean"
        },
        "verdict_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "budget_bytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "footer": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "bytes_read",
        "artifacts_read",
        "truncated",
        "verdict_count",
        "budget_bytes",
        "footer"
      ],
      "additionalProperties": false
    },
    "low_confidence": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "contention_version",
    "state",
    "claims",
    "equivalence_classes",
    "gaps",
    "provenance",
    "low_confidence"
  ],
  "additionalProperties": false
}
