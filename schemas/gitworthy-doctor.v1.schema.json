{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0-draft.1"
    },
    "gitworthy_version": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "string",
      "const": "doctor"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "cached": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "checked": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "not_checked": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "skipped",
              "failed",
              "not_applicable"
            ]
          },
          "duration_ms": {
            "type": "number",
            "minimum": 0
          },
          "cached": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "default": [],
      "type": "array",
      "items": {}
    },
    "metrics": {
      "default": {},
      "type": "object",
      "properties": {
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "github_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "git_commands": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bytes_read": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cache_hits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": {}
    },
    "capabilities_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warn",
              "fail",
              "skipped",
              "inconclusive"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "remediation": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "status",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "ACT",
        "VERIFY",
        "SKIP"
      ]
    }
  },
  "required": [
    "schema_version",
    "gitworthy_version",
    "command",
    "run_id",
    "generated_at",
    "cached",
    "summary",
    "checked",
    "not_checked",
    "checks",
    "findings",
    "metrics"
  ],
  "additionalProperties": {}
}
